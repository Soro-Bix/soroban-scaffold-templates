#[test]
fn test_approve_on_non_delivered_milestone_fails() {
    let env = Env::default();
    env.mock_all_auths();
    let (_, escrow) = setup(&env);

    let parties = Parties {
        client: Address::generate(&env),
        freelancer: Address::generate(&env),
        arbiter: Address::generate(&env),
    };
    let token_admin = Address::generate(&env);
    let (token_address, asset_client, _token_client) = create_token(&env, &token_admin);
    asset_client.mint(&parties.client, &100);

    init_job(&env, &escrow, &parties, &token_address, &[100]);
    escrow.fund(&parties.client);

    let result = escrow.try_approve_milestone(&parties.client, &0);
    assert_eq!(result, Err(Ok(EscrowError::InvalidStatus)));
}
