use super::*;
use soroban_sdk::{testutils::Address as _, testutils::Events, vec, Address, Env, IntoVal, Symbol};

fn create_and_register(env: &Env) -> Address {
    env.mock_all_auths();
    env.register(CounterContract, ())
}

#[test]
fn test_increment_from_zero() {
    let env = Env::default();
    let contract_id = create_and_register(&env);
    let client = CounterContractClient::new(&env, &contract_id);

    let result = client.increment();
    assert_eq!(result, 1);

    let events = env.events().all();
    assert_eq!(events.len(), 1);
    assert_eq!(
        events,
        vec![
            &env,
            (
                contract_id.clone(),
                (Symbol::new(&env, "incr"),).into_val(&env),
                1u32.into_val(&env)
            )
        ]
    );
}

#[test]
fn test_increment_multiple_times() {
    let env = Env::default();
    let contract_id = create_and_register(&env);
    let client = CounterContractClient::new(&env, &contract_id);

    assert_eq!(client.increment(), 1);
    assert_eq!(client.increment(), 2);
    assert_eq!(client.increment(), 3);
    assert_eq!(client.get_count(), 3);
}

#[test]
fn test_decrement_from_zero_stays_at_zero() {
    let env = Env::default();
    let contract_id = create_and_register(&env);
    let client = CounterContractClient::new(&env, &contract_id);

    let result = client.decrement();
    assert_eq!(result, 0);
    assert_eq!(client.get_count(), 0);
}

#[test]
fn test_decrement_after_increment() {
    let env = Env::default();
    let contract_id = create_and_register(&env);
    let client = CounterContractClient::new(&env, &contract_id);

    assert_eq!(client.increment(), 1);
    assert_eq!(client.increment(), 2);
    assert_eq!(client.decrement(), 1);
    assert_eq!(client.get_count(), 1);
}

#[test]
fn test_get_count_defaults_to_zero() {
    let env = Env::default();
    let contract_id = create_and_register(&env);
    let client = CounterContractClient::new(&env, &contract_id);

    assert_eq!(client.get_count(), 0);
}

#[test]
fn test_reset_sets_count_back_to_zero() {
    let env = Env::default();
    let contract_id = create_and_register(&env);
    let client = CounterContractClient::new(&env, &contract_id);
    let admin = Address::generate(&env);

    client.initialize(&admin);
    client.increment();
    client.increment();
    client.increment();
    assert_eq!(client.get_count(), 3);

    client.reset(&admin);
    assert_eq!(client.get_count(), 0);
}

#[test]
fn test_unauthorized_reset_fails() {
    let env = Env::default();
    let contract_id = create_and_register(&env);
    let client = CounterContractClient::new(&env, &contract_id);
    let admin = Address::generate(&env);
    let not_admin = Address::generate(&env);

    client.initialize(&admin);
    client.increment();

    let result = client.try_reset(&not_admin);
    assert_eq!(result, Err(Ok(Error::Unauthorized)));
    assert_eq!(client.get_count(), 1);
}
