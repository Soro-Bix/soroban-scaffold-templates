#![no_std]
use soroban_sdk::{{contract, contracterror, contractimpl, contracttype, symbol_short, Address, Env, String, Vec}};

#[contracttype]
#[derive(Clone)]
enum DataKey {{
    Admin,
    Name,
    Symbol,
    NextTokenId,
    Owner(u32),
    TokenUri(u32),
    Balance(Address, u32),
    Approval(u32, Address),
    OperatorApproval(Address, Address),
}}

#[contracterror]
#[derive(Copy, Clone, Debug, Eq, PartialEq, PartialOrd, Ord)]
#[repr(u32)]
pub enum NftError {{
    AlreadyInitialized = 1,
    NotInitialized = 2,
    Unauthorized = 3,
    TokenNotFound = 4,
    NotOwner = 5,
    InvalidTokenId = 6,
    TransferToZero = 7,
}}

fn check_initialized(env: &Env) -> Result<(), NftError> {{
    if !env.storage().instance().has(&DataKey::Admin) {{
        return Err(NftError::NotInitialized);
    }}
    Ok(())
}}

#[contract]
pub struct NftContract;

#[contractimpl]
impl NftContract {{
    pub fn initialize(env: Env, admin: Address, name: String, symbol: String) -> Result<(), NftError> {{
        if env.storage().instance().has(&DataKey::Admin) {{
            return Err(NftError::AlreadyInitialized);
        }}
        env.storage().instance().set(&DataKey::Admin, &admin);
        env.storage().instance().set(&DataKey::Name, &name);
        env.storage().instance().set(&DataKey::Symbol, &symbol);
        env.storage().instance().set(&DataKey::NextTokenId, &1u32);
        Ok(())
    }}

    pub fn name(env: Env) -> Result<String, NftError> {{
        check_initialized(&env)?;
        Ok(env.storage().instance().get(&DataKey::Name).unwrap())
    }}

    pub fn symbol(env: Env) -> Result<String, NftError> {{
        check_initialized(&env)?;
        Ok(env.storage().instance().get(&DataKey::Symbol).unwrap())
    }}

    pub fn mint(env: Env, to: Address, uri: String) -> Result<u32, NftError> {{
        check_initialized(&env)?;
        let admin: Address = env.storage().instance().get(&DataKey::Admin).unwrap();
        admin.require_auth();
        let token_id: u32 = env.storage().instance().get(&DataKey::NextTokenId).unwrap();
        env.storage().persistent().set(&DataKey::Owner(token_id), &to);
        env.storage().persistent().set(&DataKey::TokenUri(token_id), &uri);
        env.storage().instance().set(&DataKey::NextTokenId, &(token_id + 1));
        env.events().publish((symbol_short!("mint"),), (to, token_id));
        Ok(token_id)
    }}

    pub fn owner_of(env: Env, token_id: u32) -> Result<Address, NftError> {{
        check_initialized(&env)?;
        env.storage().persistent().get(&DataKey::Owner(token_id))
            .ok_or(NftError::TokenNotFound)
    }}

    pub fn token_uri(env: Env, token_id: u32) -> Result<String, NftError> {{
        check_initialized(&env)?;
        env.storage().persistent().get(&DataKey::TokenUri(token_id))
            .ok_or(NftError::TokenNotFound)
    }}

    pub fn transfer(env: Env, from: Address, to: Address, token_id: u32) -> Result<(), NftError> {{
        check_initialized(&env)?;
        from.require_auth();
        let owner: Address = env.storage().persistent().get(&DataKey::Owner(token_id))
            .ok_or(NftError::TokenNotFound)?;
        if owner != from {{
            return Err(NftError::NotOwner);
        }}
        if to == Address::from_string(&String::from_str(&env, "")) {{
            return Err(NftError::TransferToZero);
        }}
        env.storage().persistent().set(&DataKey::Owner(token_id), &to);
        env.storage().persistent().remove(&DataKey::Approval(token_id, Address::from_string(&String::from_str(&env, ""))));
        env.events().publish((symbol_short!("transfer"),), (from, to, token_id));
        Ok(())
    }}

    pub fn balance_of(env: Env, owner: Address) -> u32 {{
        let mut count = 0u32;
        let next: u32 = env.storage().instance().get(&DataKey::NextTokenId).unwrap_or(1);
        for token_id in 1..next {{
            if let Some(addr) = env.storage().persistent().get::<DataKey, Address>(&DataKey::Owner(token_id)) {{
                if addr == owner {{ count += 1; }}
            }}
        }}
        count
    }}
}}
