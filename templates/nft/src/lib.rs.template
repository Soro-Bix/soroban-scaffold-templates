#![no_std]
use soroban_sdk::{
    contract, contracterror, contractimpl, contracttype, symbol_short, Address, Env, String,
};

#[contracttype]
#[derive(Clone)]
enum DataKey {
    Admin,
    Name,
    Symbol,
    Owner(u64),
    Metadata(u64),
    Approved(u64),
    Balance(Address),
    TotalSupply,
}

#[contracterror]
#[derive(Copy, Clone, Debug, Eq, PartialEq, PartialOrd, Ord)]
#[repr(u32)]
pub enum NftError {
    AlreadyInitialized = 1,
    NotInitialized = 2,
    TokenAlreadyExists = 3,
    TokenNotFound = 4,
    NotOwner = 5,
    NotApproved = 6,
    Unauthorized = 7,
}

fn require_initialized(env: &Env) -> Result<Address, NftError> {
    env.storage()
        .instance()
        .get(&DataKey::Admin)
        .ok_or(NftError::NotInitialized)
}

fn read_owner(env: &Env, token_id: u64) -> Result<Address, NftError> {
    env.storage()
        .persistent()
        .get(&DataKey::Owner(token_id))
        .ok_or(NftError::TokenNotFound)
}

fn read_balance(env: &Env, owner: &Address) -> u32 {
    env.storage()
        .persistent()
        .get(&DataKey::Balance(owner.clone()))
        .unwrap_or(0)
}

fn write_balance(env: &Env, owner: &Address, amount: u32) {
    env.storage()
        .persistent()
        .set(&DataKey::Balance(owner.clone()), &amount);
}

fn clear_approval(env: &Env, token_id: u64) {
    env.storage().persistent().remove(&DataKey::Approved(token_id));
}

#[contract]
pub struct NftContract;

#[contractimpl]
impl NftContract {
    pub fn initialize(
        env: Env,
        admin: Address,
        name: String,
        symbol: String,
    ) -> Result<(), NftError> {
        if env.storage().instance().has(&DataKey::Admin) {
            return Err(NftError::AlreadyInitialized);
        }
        admin.require_auth();

        env.storage().instance().set(&DataKey::Admin, &admin);
        env.storage().instance().set(&DataKey::Name, &name);
        env.storage().instance().set(&DataKey::Symbol, &symbol);
        env.storage().instance().set(&DataKey::TotalSupply, &0u64);

        Ok(())
    }

    pub fn mint(
        env: Env,
        admin: Address,
        to: Address,
        token_id: u64,
        metadata_uri: String,
    ) -> Result<(), NftError> {
        let stored_admin = require_initialized(&env)?;
        if admin != stored_admin {
            return Err(NftError::Unauthorized);
        }
        admin.require_auth();

        if env.storage().persistent().has(&DataKey::Owner(token_id)) {
            return Err(NftError::TokenAlreadyExists);
        }

        env.storage()
            .persistent()
            .set(&DataKey::Owner(token_id), &to);
        env.storage()
            .persistent()
            .set(&DataKey::Metadata(token_id), &metadata_uri);
        write_balance(&env, &to, read_balance(&env, &to) + 1);

        let supply: u64 = env
            .storage()
            .instance()
            .get(&DataKey::TotalSupply)
            .unwrap_or(0);
        env.storage()
            .instance()
            .set(&DataKey::TotalSupply, &(supply + 1));

        env.events()
            .publish((symbol_short!("mint"), to), token_id);

        Ok(())
    }

    pub fn transfer(env: Env, from: Address, to: Address, token_id: u64) -> Result<(), NftError> {
        require_initialized(&env)?;
        from.require_auth();

        let owner = read_owner(&env, token_id)?;
        if owner != from {
            return Err(NftError::NotOwner);
        }

        env.storage()
            .persistent()
            .set(&DataKey::Owner(token_id), &to);
        write_balance(&env, &from, read_balance(&env, &from) - 1);
        write_balance(&env, &to, read_balance(&env, &to) + 1);
        // A new owner must not inherit the previous owner's approvals.
        clear_approval(&env, token_id);

        env.events()
            .publish((symbol_short!("transfer"), from, to), token_id);

        Ok(())
    }

    pub fn approve(
        env: Env,
        owner: Address,
        spender: Address,
        token_id: u64,
    ) -> Result<(), NftError> {
        require_initialized(&env)?;
        owner.require_auth();

        let current_owner = read_owner(&env, token_id)?;
        if current_owner != owner {
            return Err(NftError::NotOwner);
        }

        env.storage()
            .persistent()
            .set(&DataKey::Approved(token_id), &spender);

        env.events()
            .publish((symbol_short!("approve"), owner, spender), token_id);

        Ok(())
    }

    pub fn transfer_from(
        env: Env,
        spender: Address,
        from: Address,
        to: Address,
        token_id: u64,
    ) -> Result<(), NftError> {
        require_initialized(&env)?;
        spender.require_auth();

        let owner = read_owner(&env, token_id)?;
        if owner != from {
            return Err(NftError::NotOwner);
        }

        let approved: Option<Address> =
            env.storage().persistent().get(&DataKey::Approved(token_id));
        if approved != Some(spender.clone()) {
            return Err(NftError::NotApproved);
        }

        env.storage()
            .persistent()
            .set(&DataKey::Owner(token_id), &to);
        write_balance(&env, &from, read_balance(&env, &from) - 1);
        write_balance(&env, &to, read_balance(&env, &to) + 1);
        clear_approval(&env, token_id);

        env.events()
            .publish((symbol_short!("transfer"), from, to), token_id);

        Ok(())
    }

    pub fn burn(env: Env, owner: Address, token_id: u64) -> Result<(), NftError> {
        require_initialized(&env)?;
        owner.require_auth();

        let current_owner = read_owner(&env, token_id)?;
        if current_owner != owner {
            return Err(NftError::NotOwner);
        }

        env.storage().persistent().remove(&DataKey::Owner(token_id));
        env.storage()
            .persistent()
            .remove(&DataKey::Metadata(token_id));
        clear_approval(&env, token_id);
        write_balance(&env, &owner, read_balance(&env, &owner) - 1);

        let supply: u64 = env
            .storage()
            .instance()
            .get(&DataKey::TotalSupply)
            .unwrap_or(0);
        env.storage()
            .instance()
            .set(&DataKey::TotalSupply, &(supply - 1));

        env.events()
            .publish((symbol_short!("burn"), owner), token_id);

        Ok(())
    }

    pub fn owner_of(env: Env, token_id: u64) -> Result<Address, NftError> {
        read_owner(&env, token_id)
    }

    pub fn token_uri(env: Env, token_id: u64) -> Result<String, NftError> {
        env.storage()
            .persistent()
            .get(&DataKey::Metadata(token_id))
            .ok_or(NftError::TokenNotFound)
    }

    pub fn get_approved(env: Env, token_id: u64) -> Option<Address> {
        env.storage().persistent().get(&DataKey::Approved(token_id))
    }

    pub fn balance_of(env: Env, owner: Address) -> u32 {
        read_balance(&env, &owner)
    }

    pub fn total_supply(env: Env) -> u64 {
        env.storage()
            .instance()
            .get(&DataKey::TotalSupply)
            .unwrap_or(0)
    }

    pub fn name(env: Env) -> Result<String, NftError> {
        env.storage()
            .instance()
            .get(&DataKey::Name)
            .ok_or(NftError::NotInitialized)
    }

    pub fn symbol(env: Env) -> Result<String, NftError> {
        env.storage()
            .instance()
            .get(&DataKey::Symbol)
            .ok_or(NftError::NotInitialized)
    }
}

