#![cfg(test)]
use super::*;
use soroban_sdk::testutils::Address as _;
use soroban_sdk::{Address, Env, String};

fn setup<'a>(env: &Env) -> (Address, NftContractClient<'a>) {
    let admin = Address::generate(env);
    let contract_id = env.register(NftContract, ());
    let client = NftContractClient::new(env, &contract_id);
    client.initialize(&admin, &String::from_str(env, "Test NFT"), &String::from_str(env, "TST"));
    (admin, client)
}

#[test]
fn test_mint_and_owner() {
    let env = Env::default();
    let (_admin, client) = setup(&env);
    env.mock_all_auths();
    let to = Address::generate(&env);
    let id = client.mint(&to, &String::from_str(&env, "ipfs://bafy/test"));
    assert_eq!(id, 1);
    assert_eq!(client.owner_of(&id), to);
    assert_eq!(client.name(), String::from_str(&env, "Test NFT"));
}

#[test]
fn test_mint_increments_id() {
    let env = Env::default();
    let (_admin, client) = setup(&env);
    env.mock_all_auths();
    let a = Address::generate(&env);
    let b = Address::generate(&env);
    let id1 = client.mint(&a, &String::from_str(&env, "ipfs://1"));
    let id2 = client.mint(&b, &String::from_str(&env, "ipfs://2"));
    assert_eq!((id1, id2), (1, 2));
}
