use super::*;
use soroban_sdk::testutils::Address as _;

fn setup(env: &Env) -> (Address, NftContractClient<'static>) {
    let contract_id = env.register(NftContract, ());
    let client = NftContractClient::new(env, &contract_id);
    (contract_id, client)
}

fn init_collection(env: &Env, client: &NftContractClient, admin: &Address) {
    client.initialize(
        admin,
        &String::from_str(env, "Example Collection"),
        &String::from_str(env, "EXC"),
    );
}

fn uri(env: &Env) -> String {
    String::from_str(env, "ipfs://example/1.json")
}

#[test]
fn test_initialize_sets_collection_metadata() {
    let env = Env::default();
    env.mock_all_auths();
    let (_, client) = setup(&env);
    let admin = Address::generate(&env);

    init_collection(&env, &client, &admin);

    assert_eq!(client.name(), String::from_str(&env, "Example Collection"));
    assert_eq!(client.symbol(), String::from_str(&env, "EXC"));
    assert_eq!(client.total_supply(), 0);
}

#[test]
fn test_double_initialize_fails() {
    let env = Env::default();
    env.mock_all_auths();
    let (_, client) = setup(&env);
    let admin = Address::generate(&env);

    init_collection(&env, &client, &admin);

    let result = client.try_initialize(
        &admin,
        &String::from_str(&env, "Another"),
        &String::from_str(&env, "ANO"),
    );
    assert_eq!(result, Err(Ok(NftError::AlreadyInitialized)));
}

#[test]
fn test_mint_assigns_ownership_and_metadata() {
    let env = Env::default();
    env.mock_all_auths();
    let (_, client) = setup(&env);
    let admin = Address::generate(&env);
    let alice = Address::generate(&env);

    init_collection(&env, &client, &admin);
    client.mint(&admin, &alice, &1, &uri(&env));

    assert_eq!(client.owner_of(&1), alice);
    assert_eq!(client.token_uri(&1), uri(&env));
    assert_eq!(client.balance_of(&alice), 1);
    assert_eq!(client.total_supply(), 1);
}

#[test]
fn test_unauthorized_mint_fails() {
    let env = Env::default();
    env.mock_all_auths();
    let (_, client) = setup(&env);
    let admin = Address::generate(&env);
    let stranger = Address::generate(&env);
    let alice = Address::generate(&env);

    init_collection(&env, &client, &admin);

    let result = client.try_mint(&stranger, &alice, &1, &uri(&env));
    assert_eq!(result, Err(Ok(NftError::Unauthorized)));
