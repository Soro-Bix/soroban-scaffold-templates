#![no_std]
use soroban_sdk::{{contract, contracterror, contractimpl, contracttype, symbol_short, Address, Env, String}};

#[contracttype]
#[derive(Clone)]
enum DataKey {{
    Admin,
    Beneficiary,
    TotalAmount,
    ReleasedAmount,
    StartTime,
    CliffDuration,
    VestingDuration,
    Revoked,
}}

#[contracterror]
#[derive(Copy, Clone, Debug, Eq, PartialEq, PartialOrd, Ord)]
#[repr(u32)]
pub enum VestingError {{
    AlreadyInitialized = 1,
    NotInitialized = 2,
    Unauthorized = 3,
    NothingToClaim = 4,
    AlreadyRevoked = 5,
    CliffNotReached = 6,
}}

fn check_initialized(env: &Env) -> Result<(), VestingError> {{
    if !env.storage().instance().has(&DataKey::Admin) {{
        return Err(VestingError::NotInitialized);
    }}
    Ok(())
}}

#[contract]
pub struct VestingContract;

#[contractimpl]
impl VestingContract {{
    pub fn initialize(
        env: Env,
        admin: Address,
        beneficiary: Address,
        total_amount: i128,
        start_time: u64,
        cliff_duration: u64,
        vesting_duration: u64,
    ) -> Result<(), VestingError> {{
        if env.storage().instance().has(&DataKey::Admin) {{
            return Err(VestingError::AlreadyInitialized);
        }}
        env.storage().instance().set(&DataKey::Admin, &admin);
        env.storage().instance().set(&DataKey::Beneficiary, &beneficiary);
        env.storage().instance().set(&DataKey::TotalAmount, &total_amount);
        env.storage().instance().set(&DataKey::ReleasedAmount, &0i128);
        env.storage().instance().set(&DataKey::StartTime, &start_time);
        env.storage().instance().set(&DataKey::CliffDuration, &cliff_duration);
        env.storage().instance().set(&DataKey::VestingDuration, &vesting_duration);
        env.storage().instance().set(&DataKey::Revoked, &false);
        Ok(())
    }}

    pub fn beneficiary(env: Env) -> Result<Address, VestingError> {{
        check_initialized(&env)?;
        Ok(env.storage().instance().get(&DataKey::Beneficiary).unwrap())
    }}

    pub fn total_amount(env: Env) -> Result<i128, VestingError> {{
        check_initialized(&env)?;
        Ok(env.storage().instance().get(&DataKey::TotalAmount).unwrap())
    }}

    pub fn released(env: Env) -> Result<i128, VestingError> {{
        check_initialized(&env)?;
        Ok(env.storage().instance().get(&DataKey::ReleasedAmount).unwrap_or(0))
    }}

    pub fn vested_amount(env: Env) -> Result<i128, VestingError> {{
        check_initialized(&env)?;
        let now = env.ledger().timestamp();
        let start: u64 = env.storage().instance().get(&DataKey::StartTime).unwrap();
        let cliff: u64 = env.storage().instance().get(&DataKey::CliffDuration).unwrap();
        let duration: u64 = env.storage().instance().get(&DataKey::VestingDuration).unwrap();
        let total: i128 = env.storage().instance().get(&DataKey::TotalAmount).unwrap();

        if now < start + cliff {{
            return Ok(0);
        }}
        if now >= start + cliff + duration {{
            return Ok(total);
        }}
        let elapsed = (now - start - cliff) as i128;
        let dur = duration as i128;
        Ok(total * elapsed / dur)
    }}

    pub fn claimable_amount(env: Env) -> Result<i128, VestingError> {{
        check_initialized(&env)?;
        let vested = Self::vested_amount(env.clone())?;
        let released: i128 = env.storage().instance().get(&DataKey::ReleasedAmount).unwrap_or(0);
        Ok(vested - released)
    }}

    pub fn claim(env: Env) -> Result<i128, VestingError> {{
        check_initialized(&env)?;
        let beneficiary: Address = env.storage().instance().get(&DataKey::Beneficiary).unwrap();
        beneficiary.require_auth();
        let amount = Self::claimable_amount(env.clone())?;
        if amount <= 0 {{
            return Err(VestingError::NothingToClaim);
        }}
        let released: i128 = env.storage().instance().get(&DataKey::ReleasedAmount).unwrap_or(0);
        env.storage().instance().set(&DataKey::ReleasedAmount, &(released + amount));
        env.events().publish((symbol_short!("claim"),), (beneficiary, amount));
        Ok(amount)
    }}

    pub fn revoke(env: Env) -> Result<(), VestingError> {{
        check_initialized(&env)?;
        let admin: Address = env.storage().instance().get(&DataKey::Admin).unwrap();
        admin.require_auth();
        let revoked: bool = env.storage().instance().get(&DataKey::Revoked).unwrap_or(false);
        if revoked {{
            return Err(VestingError::AlreadyRevoked);
        }}
        env.storage().instance().set(&DataKey::Revoked, &true);
        env.events().publish((symbol_short!("revoke"),), admin);
        Ok(())
    }}

    pub fn is_revoked(env: Env) -> Result<bool, VestingError> {{
        check_initialized(&env)?;
        Ok(env.storage().instance().get(&DataKey::Revoked).unwrap_or(false))
    }}

    pub fn get_schedule(env: Env) -> Result<(u64, u64, u64), VestingError> {{
        check_initialized(&env)?;
        let start: u64 = env.storage().instance().get(&DataKey::StartTime).unwrap();
        let cliff: u64 = env.storage().instance().get(&DataKey::CliffDuration).unwrap();
        let duration: u64 = env.storage().instance().get(&DataKey::VestingDuration).unwrap();
        Ok((start, cliff, duration))
    }}
}}
