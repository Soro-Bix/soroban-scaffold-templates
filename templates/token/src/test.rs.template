#![cfg(test)]
use super::*;
use soroban_sdk::testutils::Address as _;
use soroban_sdk::{Address, Env, String};

fn setup<'a>(env: &Env) -> (Address, TokenContractClient<'a>) {
    let admin = Address::generate(env);
    let contract_id = env.register(TokenContract, ());
    let client = TokenContractClient::new(env, &contract_id);
    client.initialize(&admin, &String::from_str(env, "Test Token"), &String::from_str(env, "TT"), &7, &1_000_000);
    (admin, client)
}

#[test]
fn test_metadata() {
    let env = Env::default();
    let (_admin, client) = setup(&env);
    assert_eq!(client.name(), String::from_str(&env, "Test Token"));
    assert_eq!(client.symbol(), String::from_str(&env, "TT"));
    assert_eq!(client.decimals(), 7);
    assert_eq!(client.total_supply(), 1_000_000);
}

#[test]
fn test_transfer_and_allowance() {
    let env = Env::default();
    let (admin, client) = setup(&env);
    env.mock_all_auths();
    let to = Address::generate(&env);
    client.transfer(&admin, &to, &250).unwrap();
    assert_eq!(client.balance(&to), 250);
    client.approve(&admin, &to, &100);
    assert_eq!(client.allowance(&admin, &to), 100);
}
