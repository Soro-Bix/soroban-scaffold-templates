#![no_std]
use soroban_sdk::{contract, contracterror, contractimpl, contracttype, Address, Env, Vec};

#[contracttype]
#[derive(Clone)]
pub struct Transfer {
    pub to: Address,
    pub amount: i128,
    pub release_time: u64,
    pub executed: bool,
}

#[contracttype]
#[derive(Clone)]
pub enum DataKey {
    Admin,
    Nonce,
    Transfer(u32),
}

#[contracterror]
#[derive(Copy, Clone, Debug, Eq, PartialEq, PartialOrd, Ord)]
#[repr(u32)]
pub enum Error {
    Unauthorized = 1,
    UnknownTransfer = 2,
    TooEarly = 3,
    AlreadyExecuted = 4,
}

#[contract]
pub struct TimelockContract;

#[contractimpl]
impl TimelockContract {
    pub fn initialize(env: Env, admin: Address) {
        env.storage().instance().set(&DataKey::Admin, &admin);
        env.storage().instance().set(&DataKey::Nonce, &0u32);
    }

    pub fn schedule(env: Env, to: Address, amount: i128, release_time: u64) -> u32 {
        let admin: Address = env.storage().instance().get(&DataKey::Admin).unwrap();
        admin.require_auth();
        let nonce: u32 = env.storage().instance().get(&DataKey::Nonce).unwrap_or(0);
        let id = nonce + 1;
        env.storage().instance().set(&DataKey::Nonce, &id);
        env.storage().persistent().set(&DataKey::Transfer(id), &Transfer {
            to, amount, release_time, executed: false,
        });
        id
    }

    pub fn release_time(env: Env, id: u32) -> Result<u64, Error> {
        let t: Transfer = env.storage().persistent().get(&DataKey::Transfer(id)).ok_or(Error::UnknownTransfer)?;
        Ok(t.release_time)
    }

    pub fn execute(env: Env, id: u32) -> Result<(), Error> {
        let t: Transfer = env.storage().persistent().get(&DataKey::Transfer(id)).ok_or(Error::UnknownTransfer)?;
        if t.executed {
            return Err(Error::AlreadyExecuted);
        }
        let now = env.ledger().timestamp();
        if now < t.release_time {
            return Err(Error::TooEarly);
        }
        env.storage().persistent().set(&DataKey::Transfer(id), &Transfer { executed: true, ..t });
        let _ = (t.to, t.amount);
        Ok(())
    }

    pub fn is_executed(env: Env, id: u32) -> Result<bool, Error> {
        let t: Transfer = env.storage().persistent().get(&DataKey::Transfer(id)).ok_or(Error::UnknownTransfer)?;
        Ok(t.executed)
    }
}
