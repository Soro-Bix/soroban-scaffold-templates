#![no_std]
use soroban_sdk::{{contract, contracterror, contractimpl, contracttype, symbol_short, Address, Env, String, Map}};

#[contracttype]
#[derive(Clone)]
enum DataKey {{
    Admin,
    Beneficiary,
    ReleaseTime,
    TotalAmount,
    ReleasedAmount,
    Revoked,
}}

#[contracterror]
#[derive(Copy, Clone, Debug, Eq, PartialEq, PartialOrd, Ord)]
#[repr(u32)]
pub enum TimelockError {{
    AlreadyInitialized = 1,
    NotInitialized = 2,
    Unauthorized = 3,
    TooEarly = 4,
    NothingToRelease = 5,
    AlreadyRevoked = 6,
    RevokePeriodExpired = 7,
}}

fn check_initialized(env: &Env) -> Result<(), TimelockError> {{
    if !env.storage().instance().has(&DataKey::Admin) {{
        return Err(TimelockError::NotInitialized);
    }}
    Ok(())
}}

#[contract]
pub struct TimelockContract;

#[contractimpl]
impl TimelockContract {{
    pub fn initialize(
        env: Env,
        admin: Address,
        beneficiary: Address,
        release_time: u64,
        total_amount: i128,
    ) -> Result<(), TimelockError> {{
        if env.storage().instance().has(&DataKey::Admin) {{
            return Err(TimelockError::AlreadyInitialized);
        }}
        env.storage().instance().set(&DataKey::Admin, &admin);
        env.storage().instance().set(&DataKey::Beneficiary, &beneficiary);
        env.storage().instance().set(&DataKey::ReleaseTime, &release_time);
        env.storage().instance().set(&DataKey::TotalAmount, &total_amount);
        env.storage().instance().set(&DataKey::ReleasedAmount, &0i128);
        env.storage().instance().set(&DataKey::Revoked, &false);
        Ok(())
    }}

    pub fn beneficiary(env: Env) -> Result<Address, TimelockError> {{
        check_initialized(&env)?;
        Ok(env.storage().instance().get(&DataKey::Beneficiary).unwrap())
    }}

    pub fn release_time(env: Env) -> Result<u64, TimelockError> {{
        check_initialized(&env)?;
        Ok(env.storage().instance().get(&DataKey::ReleaseTime).unwrap())
    }}

    pub fn total_amount(env: Env) -> Result<i128, TimelockError> {{
        check_initialized(&env)?;
        Ok(env.storage().instance().get(&DataKey::TotalAmount).unwrap())
    }}

    pub fn released(env: Env) -> Result<i128, TimelockError> {{
        check_initialized(&env)?;
        Ok(env.storage().instance().get(&DataKey::ReleasedAmount).unwrap_or(0))
    }}

    pub fn releasable_amount(env: Env) -> Result<i128, TimelockError> {{
        check_initialized(&env)?;
        let release_time: u64 = env.storage().instance().get(&DataKey::ReleaseTime).unwrap();
        let now = env.ledger().timestamp();
        if now < release_time {{
            return Ok(0);
        }}
        let total: i128 = env.storage().instance().get(&DataKey::TotalAmount).unwrap();
        let released: i128 = env.storage().instance().get(&DataKey::ReleasedAmount).unwrap_or(0);
        Ok(total - released)
    }}

    pub fn release(env: Env) -> Result<i128, TimelockError> {{
        check_initialized(&env)?;
        let beneficiary: Address = env.storage().instance().get(&DataKey::Beneficiary).unwrap();
        beneficiary.require_auth();
        let amount = Self::releasable_amount(env.clone())?;
        if amount == 0 {{
            return Err(TimelockError::NothingToRelease);
        }}
        let released: i128 = env.storage().instance().get(&DataKey::ReleasedAmount).unwrap_or(0);
        env.storage().instance().set(&DataKey::ReleasedAmount, &(released + amount));
        env.events().publish((symbol_short!("release"),), (beneficiary, amount));
        Ok(amount)
    }}

    pub fn revoke(env: Env) -> Result<(), TimelockError> {{
        check_initialized(&env)?;
        let admin: Address = env.storage().instance().get(&DataKey::Admin).unwrap();
        admin.require_auth();
        let revoked: bool = env.storage().instance().get(&DataKey::Revoked).unwrap_or(false);
        if revoked {{
            return Err(TimelockError::AlreadyRevoked);
        }}
        env.storage().instance().set(&DataKey::Revoked, &true);
        env.events().publish((symbol_short!("revoke"),), admin);
        Ok(())
    }}

    pub fn is_revoked(env: Env) -> Result<bool, TimelockError> {{
        check_initialized(&env)?;
        Ok(env.storage().instance().get(&DataKey::Revoked).unwrap_or(false))
    }}
}}
